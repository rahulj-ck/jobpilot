# Copy this to .env.local and fill in your values
# This file is for running the apply script locally — never commit it

# Supabase (same as your Vercel env vars)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Your application details
APPLY_FIRST_NAME=Rahul
APPLY_LAST_NAME=YourLastName
APPLY_EMAIL=you@gmail.com
APPLY_PHONE=+1 555 123 4567
APPLY_LINKEDIN=https://linkedin.com/in/yourname
APPLY_RESUME_PATH=/Users/apple/Documents/resume.pdf   # absolute path to your PDF

APPLY_TITLE=Senior Frontend Engineer
APPLY_SKILLS=React, TypeScript, Node.js, GraphQL, AWS
APPLY_EXPERIENCE=5 years
APPLY_BIO=Passionate frontend engineer with expertise in building scalable web applications.

APPLY_WORK_AUTH=yes           # yes | no | visa
APPLY_SPONSORSHIP=no          # yes | no
APPLY_SALARY_MIN=140000
APPLY_SALARY_MAX=200000

# Run settings
APPLY_MAX_PER_RUN=20          # max applications per run
APPLY_DELAY_MIN=30            # min seconds between applications
APPLY_DELAY_MAX=90            # max seconds between applications
